  <!--
    Two builds of the plugin.
    The working one (the default): with the reference pages UI Gallery and Icons in the
    Debug tab, built into bin/plugins of the project.
    The one for the store (pass /p:ArtistToolStore=true to MSBuild): the reference pages
    are not compiled into it at all. It is built into store_build/ next to the project
    folder, so the working build stays as it is.

    Both keep their intermediate files (objects, logs) out of the source folder, in
    artist_tool_build/ next to the project folder: the source folder is the git
    repository and what a package of the plugin is made from, and build leftovers must
    not get into either.
  -->
  <PropertyGroup Condition="'$(ArtistToolStore)'!='true'">
    <ArtistToolDevPages>true</ArtistToolDevPages>
    <IntDir>$(ProjectDir)../../../../../artist_tool_build/$(Platform)/$(Configuration)/</IntDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ArtistToolStore)'=='true'">
    <ArtistToolDevPages>false</ArtistToolDevPages>
    <OutDir>$(ProjectDir)../../../../../store_build/plugins/zloy_pingvin/artist_tool/</OutDir>
    <IntDir>$(ProjectDir)../../../../../artist_tool_build/$(Platform)/Store_$(Configuration)/</IntDir>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" />
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <Optimization>Disabled</Optimization>
